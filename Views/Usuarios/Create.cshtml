@model EMDERSOFT.Models.Usuario

@{
    ViewData["Title"] = "Crear Usuario";
}

<div class="container mt-4">
    <h2>Registrar Nuevo Usuario</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        
                        <div class="mb-3">
                            <label asp-for="Username" class="form-label fw-medium"></label>
                            <input asp-for="Username" class="form-control" />
                            <span asp-validation-for="Username" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-medium"></label>
                            <input asp-for="Password" type="password" class="form-control" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-4">
                            <label asp-for="Rol" class="form-label fw-medium">Nivel de Acceso</label>
                            <select asp-for="Rol" class="form-select">
                                <option value="Administrador">Administrador</option>
                                <option value="Jefe de Proyecto">Jefe de Proyecto</option>
                                <option value="Encargado de Almacén">Encargado de Almacén</option>
                                <option value="Responsable de Sede">Responsable de Sede</option>
                            </select>
                            <span asp-validation-for="Rol" class="text-danger"></span>
                        </div>
                        
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success"><i class="bi bi-save"></i> Guardar</button>
                            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
