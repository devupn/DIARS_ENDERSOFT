@model IEnumerable<EMDERSOFT.Models.Usuario>

@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Gestión de Usuarios</h2>
        <a asp-action="Create" class="btn btn-success"><i class="bi bi-person-plus"></i> Agregar Usuario</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Usuario</th>
                        <th>Nivel de Acceso</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="align-middle fw-medium">@item.Username</td>
                            <td class="align-middle">
                                @if (item.Rol == "Administrador")
                                {
                                    <span class="badge bg-danger">@item.Rol</span>
                                }
                                else if (item.Rol == "Jefe de Proyecto")
                                {
                                    <span class="badge bg-primary">@item.Rol</span>
                                }
                                else if (item.Rol == "Encargado de Almacén")
                                {
                                    <span class="badge bg-success">@item.Rol</span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-dark">@item.Rol</span>
                                }
                            </td>
                            <td class="text-end align-middle">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm"><i class="bi bi-pencil-square"></i> Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm"><i class="bi bi-trash"></i> Eliminar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
