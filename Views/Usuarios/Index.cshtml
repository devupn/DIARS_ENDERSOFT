@model IEnumerable<EMDERSOFT.Models.Usuario>

@{
    ViewData["Title"] = "Gestion de Usuarios";
}

<div class="page-header">
    <div class="breadcrumb-custom">
        <a asp-controller="Home" asp-action="Index">Inicio</a>
        <i class="bi bi-chevron-right" style="font-size:10px;"></i>
        Usuarios
    </div>
    <div class="page-header-title">Gestion de Usuarios</div>
    <div class="page-header-sub">Administra los accesos y roles del sistema</div>
</div>

<div class="section-card">
    <div class="section-card-header">
        <div class="section-card-title">
            <i class="bi bi-people" style="color: var(--accent);"></i>
            Usuarios Registrados
        </div>
        <a asp-action="Create" class="btn-primary-custom">
            <i class="bi bi-person-plus"></i>
            <span class="d-none d-sm-inline">Agregar Usuario</span>
        </a>
    </div>
    <div class="table-wrapper">
        <table class="table-modern">
            <thead>
                <tr>
                    <th>Usuario</th>
                    <th>Nivel de Acceso</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="avatar-sm" style="width:32px; height:32px; font-size:12px;">
                                    @(item.Username?.Length >= 2 ? item.Username.Substring(0, 2).ToUpper() : "US")
                                </div>
                                <span style="font-weight:600;">@item.Username</span>
                            </div>
                        </td>
                        <td>
                            @if (item.Rol == "Administrador")
                            {
                                <span class="badge bg-danger" style="border-radius:8px; font-size:11.5px;">@item.Rol</span>
                            }
                            else if (item.Rol == "Jefe de Proyecto")
                            {
                                <span class="badge bg-primary" style="border-radius:8px; font-size:11.5px;">@item.Rol</span>
                            }
                            else if (item.Rol == "Encargado de Almacen")
                            {
                                <span class="badge bg-success" style="border-radius:8px; font-size:11.5px;">@item.Rol</span>
                            }
                            else
                            {
                                <span class="badge bg-info text-dark" style="border-radius:8px; font-size:11.5px;">@item.Rol</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-flex gap-1 justify-content-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm" style="border-radius:7px; font-size:12px;">
                                    <i class="bi bi-pencil-square"></i>
                                    <span class="d-none d-md-inline ms-1">Editar</span>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" style="border-radius:7px; font-size:12px;">
                                    <i class="bi bi-trash"></i>
                                    <span class="d-none d-md-inline ms-1">Eliminar</span>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
