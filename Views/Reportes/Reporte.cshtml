@model EMDERSOFT.Patterns.Builder.ReporteHerramientas
@{ ViewData["Title"] = Model.Titulo; }

<div class="page-header">
    <div class="breadcrumb-custom">
        <a asp-controller="Home" asp-action="Index">Inicio</a>
        <i class="bi bi-chevron-right" style="font-size:10px;"></i>
        <a asp-action="Index">Reportes</a>
        <i class="bi bi-chevron-right" style="font-size:10px;"></i>
        @Model.Titulo
    </div>
    <div class="page-header-title">@Model.Titulo</div>
    <div class="page-header-sub">Generado el @Model.FechaGeneracion.ToString("dd/MM/yyyy HH:mm")</div>
</div>

<div class="d-flex gap-2 flex-wrap mb-4">
    @foreach (var seccion in Model.SeccionesIncluidas)
    {
        <span class="badge bg-secondary" style="border-radius:8px; font-size:12px; padding: 5px 10px;">@seccion</span>
    }
</div>

<div class="row g-4 mb-4">
    <div class="col-12 col-sm-6">
        <div class="stat-card">
            <div class="stat-icon blue"><i class="bi bi-boxes"></i></div>
            <div>
                <div class="stat-value">@Model.TotalHerramientas</div>
                <div class="stat-label">Total Herramientas Distintas</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6">
        <div class="stat-card">
            <div class="stat-icon green"><i class="bi bi-layers"></i></div>
            <div>
                <div class="stat-value">@Model.TotalCantidadStock</div>
                <div class="stat-label">Unidades en Stock (Total)</div>
            </div>
        </div>
    </div>
</div>

@if (Model.HerramientasMasAbundantes != null)
{
    <div class="section-card mb-4">
        <div class="section-card-header">
            <div class="section-card-title">
                <i class="bi bi-bar-chart" style="color:var(--accent);"></i>
                Herramientas con mas stock
            </div>
        </div>
        <div class="table-wrapper">
            <table class="table-modern">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Categoria</th>
                        <th>Cantidad</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in Model.HerramientasMasAbundantes)
                    {
                        <tr>
                            <td style="font-weight:600;">@h.Nombre</td>
                            <td>@(h.Categoria?.Nombre ?? "Sin categoria")</td>
                            <td>@h.Cantidad</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (Model.HerramientasSinStock != null)
{
    <div class="section-card mb-4">
        <div class="section-card-header">
            <div class="section-card-title">
                <i class="bi bi-exclamation-circle" style="color:var(--danger);"></i>
                Herramientas sin stock
                <span style="font-size:12px; font-weight:500; color:var(--text-muted);">(@Model.HerramientasSinStock.Count)</span>
            </div>
        </div>
        <div class="section-card-body">
            @if (!Model.HerramientasSinStock.Any())
            {
                <p style="color:var(--success); font-weight:600; margin:0;">
                    <i class="bi bi-check-circle me-1"></i>Todas las herramientas tienen stock disponible.
                </p>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var h in Model.HerramientasSinStock)
                    {
                        <li class="list-group-item list-group-item-danger" style="border-radius:8px; margin-bottom:4px;">
                            <strong>@h.Nombre</strong> &mdash; @h.Ubicacion
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
}

@if (Model.ResumenPorCategoria != null)
{
    <div class="row g-4 mb-4">
        <div class="col-12 col-md-6">
            <div class="section-card">
                <div class="section-card-header">
                    <div class="section-card-title">
                        <i class="bi bi-tag" style="color:var(--accent);"></i>
                        Resumen por Categoria
                    </div>
                </div>
                <div class="table-wrapper">
                    <table class="table-modern">
                        <thead>
                            <tr>
                                <th>Categoria</th>
                                <th>Variedad</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cat in Model.ResumenPorCategoria)
                            {
                                <tr>
                                    <td>@cat.Key</td>
                                    <td>@cat.Value</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @if (Model.ResumenPorEstado != null)
        {
            <div class="col-12 col-md-6">
                <div class="section-card">
                    <div class="section-card-header">
                        <div class="section-card-title">
                            <i class="bi bi-activity" style="color:var(--success);"></i>
                            Resumen por Estado
                        </div>
                    </div>
                    <div class="table-wrapper">
                        <table class="table-modern">
                            <thead>
                                <tr>
                                    <th>Estado</th>
                                    <th>Variedad</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var est in Model.ResumenPorEstado)
                                {
                                    <tr>
                                        <td>@est.Key</td>
                                        <td>@est.Value</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
}

<a asp-action="Index" class="btn-outline-custom">
    <i class="bi bi-arrow-left"></i> Volver a Reportes
</a>
