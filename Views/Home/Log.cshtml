@model List<string>
@{ ViewData["Title"] = "Registro de Actividad"; }

<div class="page-header">
    <div class="breadcrumb-custom">
        <a asp-controller="Home" asp-action="Index">Inicio</a>
        <i class="bi bi-chevron-right" style="font-size:10px;"></i>
        Log del Sistema
    </div>
    <div class="page-header-title">Registro de Actividad</div>
    <div class="page-header-sub">Singleton AppLogger &mdash; mostrando los ultimos 50 registros</div>
</div>

<div class="section-card">
    <div class="section-card-header">
        <div class="section-card-title">
            <i class="bi bi-terminal" style="color:var(--accent);"></i>
            Consola de Actividad
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn-outline-custom">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>
    <div class="section-card-body" style="padding: 0;">
        <div class="log-terminal">
            @if (Model == null || !Model.Any())
            {
                <p class="log-line success">Sin registros disponibles.</p>
            }
            else
            {
                @foreach (var linea in Model)
                {
                    string cssClass = linea.Contains("ERROR") ? "error" :
                                      linea.Contains("ADVERTENCIA") ? "warning" : "success";
                    <p class="log-line @cssClass">@linea</p>
                }
            }
        </div>
    </div>
</div>
