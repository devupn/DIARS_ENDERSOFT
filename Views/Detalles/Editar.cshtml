@model EMDERSOFT.Models.DetalleHerramienta
@{
    ViewData["Title"] = "Detalle Tecnico";
}

<div class="page-header">
    <div class="breadcrumb-custom">
        <a asp-controller="Home" asp-action="Index">Inicio</a>
        <i class="bi bi-chevron-right" style="font-size:10px;"></i>
        <a asp-controller="Inventario" asp-action="Details" asp-route-id="@Model.HerramientaId">@(Model.Herramienta?.Nombre ?? "Detalle")</a>
        <i class="bi bi-chevron-right" style="font-size:10px;"></i>
        Ficha Tecnica
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8">
        <div class="form-card">
            <div class="form-section-title">Detalle Tecnico</div>
            <div class="form-section-sub">@(Model.Herramienta?.Nombre ?? "")</div>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="border-radius:10px; font-size:13.5px;"></div>

            <form asp-action="Editar" novalidate>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="HerramientaId" />

                <div class="row g-3">
                    <div class="col-12 col-sm-6">
                        <label asp-for="Marca" class="form-label"></label>
                        <input asp-for="Marca" class="form-control" placeholder="Ej: Bosch" />
                        <span asp-validation-for="Marca" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label asp-for="Modelo" class="form-label"></label>
                        <input asp-for="Modelo" class="form-control" placeholder="Ej: GSB 120" />
                        <span asp-validation-for="Modelo" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label asp-for="Peso" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="Peso" class="form-control" placeholder="0.000" />
                            <span class="input-group-text">kg</span>
                        </div>
                        <span asp-validation-for="Peso" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label asp-for="GarantiaMeses" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="GarantiaMeses" class="form-control" placeholder="12" />
                            <span class="input-group-text">meses</span>
                        </div>
                        <span asp-validation-for="GarantiaMeses" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Especificaciones" class="form-label"></label>
                        <textarea asp-for="Especificaciones" class="form-control" rows="4"
                            placeholder="Caracteristicas tecnicas de la herramienta..."></textarea>
                        <span asp-validation-for="Especificaciones" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4 flex-wrap">
                    <button type="submit" class="btn-primary-custom">
                        <i class="bi bi-save"></i> Guardar Detalle
                    </button>
                    <a asp-controller="Inventario" asp-action="Details"
                       asp-route-id="@Model.HerramientaId"
                       class="btn-outline-custom">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}