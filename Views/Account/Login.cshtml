@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Control Patrimonial</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="login-bg">
        <div class="login-panel">
            <div class="login-logo">
                <i class="bi bi-building-check"></i>
            </div>
            <div class="login-title">EMDERSOFT</div>
            <div class="login-sub">Control Patrimonial — Inicia sesion</div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger d-flex align-items-center gap-2 py-2" role="alert" style="border-radius:10px; font-size:13.5px;">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    @ViewBag.Error
                </div>
            }

            <form asp-controller="Account" asp-action="Login" method="post">
                <div class="mb-3">
                    <label for="username" class="form-label">Usuario</label>
                    <div class="input-group">
                        <span class="input-group-text" style="border: 1.5px solid #E2E8F0; border-right: none; background: #F4F7FE; border-radius: 10px 0 0 10px;">
                            <i class="bi bi-person" style="color:#6B7A99;"></i>
                        </span>
                        <input type="text" class="form-control" id="username" name="username" required
                               placeholder="Ingresa tu usuario"
                               style="border: 1.5px solid #E2E8F0; border-left: none; border-radius: 0 10px 10px 0; padding: 11px 14px; font-size: 14px; background: #F4F7FE;" />
                    </div>
                </div>
                <div class="mb-4">
                    <label for="password" class="form-label">Contrasena</label>
                    <div class="input-group">
                        <span class="input-group-text" style="border: 1.5px solid #E2E8F0; border-right: none; background: #F4F7FE; border-radius: 10px 0 0 10px;">
                            <i class="bi bi-lock" style="color:#6B7A99;"></i>
                        </span>
                        <input type="password" class="form-control" id="password" name="password" required
                               placeholder="Ingresa tu contrasena"
                               style="border: 1.5px solid #E2E8F0; border-left: none; border-radius: 0 10px 10px 0; padding: 11px 14px; font-size: 14px; background: #F4F7FE;" />
                    </div>
                </div>
                <button type="submit" class="login-btn">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Ingresar
                </button>
            </form>

            <div style="margin-top: 24px; text-align: center; font-size: 12px; color: #6B7A99;">
                Emdersoft SAC &mdash; Control Patrimonial v2.0
            </div>
        </div>
    </div>
</body>
</html>
