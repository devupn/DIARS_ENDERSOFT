@model EMDERSOFT.Models.Herramienta

@{
    ViewData["Title"] = "Agregar Herramienta";
}

<div class="page-header">
    <div class="breadcrumb-custom">
        <a asp-controller="Home" asp-action="Index">Inicio</a>
        <i class="bi bi-chevron-right" style="font-size:10px;"></i>
        <a asp-action="Index">Inventario</a>
        <i class="bi bi-chevron-right" style="font-size:10px;"></i>
        Nuevo Bien
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8 col-xl-7">
        <div class="form-card">
            <div class="form-section-title">Registrar Nuevo Bien</div>
            <div class="form-section-sub">Complete los campos para agregar una herramienta o equipo al inventario</div>

            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="border-radius:10px; font-size:13.5px;"></div>

                <div class="row g-3">
                    <div class="col-12 col-sm-8">
                        <label asp-for="Nombre" class="form-label"></label>
                        <input asp-for="Nombre" class="form-control" placeholder="Ej: Laptop Dell, Cable de red..." />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-sm-4">
                        <label asp-for="Cantidad" class="form-label"></label>
                        <input asp-for="Cantidad" class="form-control" type="number" min="0" />
                        <span asp-validation-for="Cantidad" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Descripcion" class="form-label"></label>
                        <textarea asp-for="Descripcion" class="form-control" rows="2" placeholder="Descripcion opcional..."></textarea>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label asp-for="CategoriaId" class="form-label"></label>
                        <select asp-for="CategoriaId" asp-items="ViewBag.CategoriaId" class="form-select">
                            <option value="">-- Selecciona una categoria --</option>
                        </select>
                        <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label asp-for="Estado" class="form-label"></label>
                        <select asp-for="Estado" class="form-select">
                            <option value="Disponible">Disponible</option>
                            <option value="En uso">En uso</option>
                            <option value="Danado">Danado</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <label asp-for="Ubicacion" class="form-label"></label>
                        <input asp-for="Ubicacion" class="form-control" placeholder="Ej: Oficina 1, Almacen..." />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Etiquetas</label>
                        <div class="d-flex flex-wrap gap-3 p-3" style="border: 1.5px solid var(--border); border-radius: 10px; background: var(--bg);">
                            @if (ViewBag.Etiquetas != null)
                            {
                                foreach (var etiqueta in ViewBag.Etiquetas)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="etiquetasSeleccionadas"
                                               value="@etiqueta.Id"
                                               id="et_@etiqueta.Id"
                                               @(etiqueta.Seleccionada ? "checked" : "") />
                                        <label class="form-check-label" for="et_@etiqueta.Id" style="font-size:13.5px;">
                                            @etiqueta.Nombre
                                        </label>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4 flex-wrap">
                    <button type="submit" class="btn-primary-custom">
                        <i class="bi bi-save"></i> Guardar
                    </button>
                    <a asp-action="Index" class="btn-outline-custom">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}