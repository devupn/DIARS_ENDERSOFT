@model IEnumerable<EMDERSOFT.Models.Herramienta>

@{
    ViewData["Title"] = "Inventario de Herramientas";
}

<div class="page-header">
    <div class="breadcrumb-custom">
        <a asp-controller="Home" asp-action="Index">Inicio</a>
        <i class="bi bi-chevron-right" style="font-size:10px;"></i>
        Inventario
    </div>
    <div class="page-header-title">Lista de Bienes</div>
    <div class="page-header-sub">Inventario de herramientas y equipos registrados en el sistema</div>
</div>

<div class="section-card">
    <div class="section-card-header">
        <div class="section-card-title">
            <i class="bi bi-table" style="color: var(--accent);"></i>
            Herramientas y Equipos
            <span style="font-size:12px; font-weight:500; color:var(--text-muted); margin-left:6px;">(@Model.Count() registros)</span>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="fw-bold text-muted" style="font-size:12.5px;">Ordenar:</span>
            @foreach (var estrategia in ViewBag.Estrategias)
            {
                var esActual = estrategia.Key == ViewBag.OrdenActual;
                <a asp-action="Index" asp-route-orden="@estrategia.Key"
                   class="btn btn-sm @(esActual ? "btn-primary" : "btn-outline-secondary")"
                   style="border-radius:8px; font-size:12px;">
                    @estrategia.Value.Nombre
                </a>
            }
            <a asp-action="Create" class="btn-primary-custom" style="margin-left: 4px;">
                <i class="bi bi-plus-lg"></i>
                <span class="d-none d-sm-inline">Agregar</span>
            </a>
        </div>
    </div>
    <div class="table-wrapper">
        <table class="table-modern">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Categoria</th>
                    <th>Cantidad</th>
                    <th>Estado</th>
                    <th class="d-none d-lg-table-cell">Etiquetas</th>
                    <th class="d-none d-md-table-cell">Ubicacion</th>
                    <th class="d-none d-lg-table-cell">Fecha Registro</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td style="font-weight:600;">@item.Nombre</td>
                        <td>
                            <span class="badge bg-primary" style="border-radius:8px; font-size:11px;">
                                @(item.Categoria?.Nombre ?? "Sin categoria")
                            </span>
                        </td>
                        <td>@item.Cantidad</td>
                        <td>
                            @if (item.Estado == "Disponible")
                            {
                                <span class="badge-status badge-active">@item.Estado</span>
                            }
                            else if (item.Estado == "En uso")
                            {
                                <span class="badge-status badge-damaged" style="background:#FFF7ED; color:#D97706;">@item.Estado</span>
                            }
                            else
                            {
                                <span class="badge-status badge-inactive">@item.Estado</span>
                            }
                        </td>
                        <td class="d-none d-lg-table-cell">
                            @foreach (var et in item.Etiquetas)
                            {
                                <span class="badge bg-secondary me-1" style="border-radius:8px; font-size:11px;">@et.Nombre</span>
                            }
                        </td>
                        <td class="d-none d-md-table-cell" style="color:var(--text-muted);">@item.Ubicacion</td>
                        <td class="d-none d-lg-table-cell" style="color:var(--text-muted); font-size:12.5px;">@item.FechaRegistro.ToString("dd/MM/yyyy")</td>
                        <td>
                            <div class="d-flex gap-1 flex-wrap">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm" style="border-radius:7px; font-size:12px;">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm" style="border-radius:7px; font-size:12px;">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" style="border-radius:7px; font-size:12px;">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>