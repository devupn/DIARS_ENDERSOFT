@model IEnumerable<EMDERSOFT.Models.Herramienta>

@{
    ViewData["Title"] = "Inventario de Herramientas";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Inventario de Herramientas y Equipos</h2>
        <a asp-action="Create" class="btn btn-success">Agregar Herramienta</a>
    </div>

    @* Selector de estrategia de ordenamiento (Patrón Strategy) *@
    <div class="d-flex align-items-center gap-2 mb-3">
        <span class="fw-bold text-muted">Ordenar por:</span>
        @foreach (var estrategia in ViewBag.Estrategias)
        {
            var esActual = estrategia.Key == ViewBag.OrdenActual;
            <a asp-action="Index" asp-route-orden="@estrategia.Key"
               class="btn btn-sm @(esActual ? "btn-primary" : "btn-outline-secondary")">
                @estrategia.Value.Nombre
            </a>
        }
    </div>
    <p class="text-muted small">
        Mostrando @Model.Count() herramientas — ordenadas por:
        <strong>@ViewBag.EstrategiaActual</strong>
    </p>

    <table class="table table-striped table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>Nombre</th>
                <th>Categoría</th>
                <th>Cantidad</th>
                <th>Estado</th>
                <th>Etiquetas</th>
                <th>Ubicación</th>
                <th>Fecha Registro</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Nombre</td>

                    <td>
                        <span class="badge bg-primary">
                            @(item.Categoria?.Nombre ?? "Sin categoría")
                        </span>
                    </td>

                    <td>@item.Cantidad</td>

                    <td>
                        @if (item.Estado == "Disponible")
                        {
                            <span class="badge bg-success">@item.Estado</span>
                        }
                        else if (item.Estado == "En uso")
                        {
                            <span class="badge bg-warning text-dark">@item.Estado</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">@item.Estado</span>
                        }
                    </td>
                    <td>
                        @foreach (var et in item.Etiquetas)
                        {
                            <span class="badge bg-secondary me-1">@et.Nombre</span>
                        }
                    </td>
                    <td>@item.Ubicacion</td>

                    <td>@item.FechaRegistro.ToString("dd/MM/yyyy")</td>

                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Editar</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Ver</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>