@model EMDERSOFT.Models.Herramienta

@{
    ViewData["Title"] = "Detalle de Herramienta";
}

<div class="page-header">
    <div class="breadcrumb-custom">
        <a asp-controller="Home" asp-action="Index">Inicio</a>
        <i class="bi bi-chevron-right" style="font-size:10px;"></i>
        <a asp-action="Index">Inventario</a>
        <i class="bi bi-chevron-right" style="font-size:10px;"></i>
        Detalle
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-7">
        <div class="detail-card">
            <div class="detail-card-header">
                <div style="width:42px; height:42px; background:rgba(255,255,255,.15); border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:20px; color:#fff; flex-shrink:0;">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div>
                    <div class="detail-card-header-title">@Model.Nombre</div>
                    <div class="detail-card-header-sub">@(Model.Categoria?.Nombre ?? "Sin categoria")</div>
                </div>
            </div>
            <div class="detail-card-body">
                <div class="detail-row">
                    <span class="detail-label">Nombre</span>
                    <span class="detail-value">@Model.Nombre</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Descripcion</span>
                    <span class="detail-value">@(string.IsNullOrWhiteSpace(Model.Descripcion) ? "—" : Model.Descripcion)</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Categoria</span>
                    <span class="detail-value">@(Model.Categoria?.Nombre ?? "Sin categoria")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Cantidad</span>
                    <span class="detail-value">@Model.Cantidad</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Estado</span>
                    <span class="detail-value">
                        @if (Model.Estado == "Disponible")
                        {
                            <span class="badge-status badge-active">@Model.Estado</span>
                        }
                        else if (Model.Estado == "En uso")
                        {
                            <span class="badge-status badge-damaged" style="background:#FFF7ED; color:#D97706;">@Model.Estado</span>
                        }
                        else
                        {
                            <span class="badge-status badge-inactive">@Model.Estado</span>
                        }
                    </span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Ubicacion</span>
                    <span class="detail-value">@(string.IsNullOrWhiteSpace(Model.Ubicacion) ? "—" : Model.Ubicacion)</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Fecha Registro</span>
                    <span class="detail-value">@Model.FechaRegistro.ToString("dd/MM/yyyy")</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-5">
        <div class="detail-card">
            <div class="detail-card-header" style="background: var(--primary-light);">
                <div style="width:42px; height:42px; background:rgba(255,255,255,.15); border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:20px; color:#fff; flex-shrink:0;">
                    <i class="bi bi-cpu"></i>
                </div>
                <div>
                    <div class="detail-card-header-title">Detalle Tecnico</div>
                    <div class="detail-card-header-sub">Especificaciones del bien</div>
                </div>
            </div>
            <div class="detail-card-body">
                @if (Model.Detalle != null)
                {
                    <div class="detail-row">
                        <span class="detail-label">Marca</span>
                        <span class="detail-value">@Model.Detalle.Marca</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Modelo</span>
                        <span class="detail-value">@Model.Detalle.Modelo</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Garantia</span>
                        <span class="detail-value">@Model.Detalle.GarantiaMeses meses</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Especificaciones</span>
                        <span class="detail-value">@Model.Detalle.Especificaciones</span>
                    </div>
                }
                else
                {
                    <div style="text-align:center; padding: 24px 0; color:var(--text-muted);">
                        <i class="bi bi-file-earmark-x" style="font-size:32px; display:block; margin-bottom:8px;"></i>
                        <span style="font-size:13.5px;">Esta herramienta aun no tiene ficha tecnica.</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="d-flex gap-2 mt-4 flex-wrap">
    <a asp-controller="Detalles" asp-action="Editar" asp-route-id="@Model.Id" class="btn-primary-custom">
        <i class="bi bi-cpu"></i>
        @(Model.Detalle != null ? "Editar Detalle" : "Agregar Detalle")
    </a>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-outline-custom">
        <i class="bi bi-pencil"></i> Editar Herramienta
    </a>
    <a asp-action="Index" class="btn-outline-custom">
        <i class="bi bi-arrow-left"></i> Volver
    </a>
</div>